# Optional paid engine keys
# Leave these unset to run on Claude only (the free default).
# Set one or more to enable additional AI engines in shared/adapters/engines.py.

# OPENAI_API_KEY=sk-...
# PERPLEXITY_API_KEY=pplx-...
# GEMINI_API_KEY=AIza...

# Optional search API (for URL discovery beyond manual input)
# See shared/adapters/search.py for supported providers.
# SEARCH_API_KEY=...
# SEARCH_PROVIDER=brave   # or: exa, serpapi

# Optional contact enrichment
# See shared/adapters/enrichment.py for supported sources.
# ENRICHMENT_SOURCE=clay   # or: apollo, csv
# CLAY_API_KEY=...
# APOLLO_API_KEY=...
# CRM_EXPORT_PATH=path/to/crm_export.csv

# DO NOT set ANTHROPIC_API_KEY here.
# This repo authenticates through your Claude subscription via `claude -p`.
# If ANTHROPIC_API_KEY is present, Claude Code bills your API account
# instead of your subscription. Run `unset ANTHROPIC_API_KEY` before using.
